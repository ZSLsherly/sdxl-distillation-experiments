+def _cpu_tensor(value, snapshot):
+    tensor = local(value).detach()
+    if snapshot:
+        # One independent CPU copy, including when the input already lives on CPU.
+        return tensor.to(device="cpu", copy=True)
+    tensor = tensor.cpu()
+    # Do not serialize a large backing allocation for a small/padded shard view.
+    if tensor.storage_offset() or tensor.untyped_storage().nbytes() != tensor.numel() * tensor.element_size():
+        tensor = tensor.clone()
+    return tensor
 
 
-def optimizer_state(optimizer):
+def cpu_state(model, *, snapshot=True):
+    return {k: _cpu_tensor(v, snapshot) for k, v in model.state_dict().items()}
+
+
+def optimizer_state(optimizer, *, snapshot=True):
     state = optimizer.state_dict()
     return {**state, "state": {
-        k: {name: local(v).detach().cpu().clone() if torch.is_tensor(v) else v
+        k: {name: _cpu_tensor(v, snapshot) if torch.is_tensor(v) else v
             for name, v in values.items()} for k, values in state["state"].items()}}
 
 
